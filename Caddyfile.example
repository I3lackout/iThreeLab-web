# Beispiel-Konfiguration für statische Produktionsauslieferung von iThreeLab.com via Caddy.
# Es werden keine Node.js-Prozesse im Produktivbetrieb benötigt.
# Vor produktiver Nutzung Domain (z. B. ithreelab.com) und Root-Pfad anpassen und nicht direkt auf VPS deployen.

{$ITHREE_SITE_ADDRESS:http://localhost:8080} {
	root * {$ITHREE_DIST_DIR:/var/www/ithreelab-web/dist}
	encode zstd gzip

	# Client-Side Routing Fallback (React Router SPA)
	try_files {path} /index.html
	file_server

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	}

	@hashed_assets path /assets/*
	header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

	@html_entry path / /index.html
	header @html_entry Cache-Control "no-cache"
}
